<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Unitree Dex1-1 parallel two-finger gripper.

    Visual and collision meshes, mass properties, and the two prismatic joint
    axes/limits are derived from Unitree's BSD-3-Clause dex1_1_service model.
    Link and joint names are prefixed for composition with the H1-2 model.
    The short adapter aligns the Dex1-1 +Y approach direction with the H1-2
    right wrist +X tool direction.
  -->

  <link name="right_dex1_adapter_link">
    <inertial>
      <origin xyz="0.005 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.000010" ixy="0" ixz="0" iyy="0.000010" iyz="0" izz="0.000018"/>
    </inertial>
    <visual>
      <origin xyz="0.005 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.010"/>
      </geometry>
      <material name="dex1_adapter_dark">
        <color rgba="0.10 0.11 0.13 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.005 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.010"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_dex1_adapter_joint" type="fixed">
    <origin xyz="0.045 0 0" rpy="0 0 0"/>
    <parent link="right_wrist_yaw_link"/>
    <child link="right_dex1_adapter_link"/>
  </joint>

  <link name="right_dex1_base_link">
    <inertial>
      <origin xyz="0.0001178 0.036886 0.0080974" rpy="0 0 0"/>
      <mass value="0.11"/>
      <inertia
        ixx="4.9533E-05" ixy="5.9474E-08" ixz="-3.1979E-08"
        iyy="6.8944E-05" iyz="-1.7064E-06" izz="3.4443E-05"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/base_link.STL"/>
      </geometry>
      <material name="dex1_body">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_dex1_mount_joint" type="fixed">
    <origin xyz="0.010 0 0" rpy="0 0 -1.57079632679"/>
    <parent link="right_dex1_adapter_link"/>
    <child link="right_dex1_base_link"/>
  </joint>

  <link name="right_dex1_finger_1_slider_link">
    <inertial>
      <origin xyz="-0.041607 0.0039411 -0.00047344" rpy="0 0 0"/>
      <mass value="0.0084398"/>
      <inertia
        ixx="1.0466E-07" ixy="4.1386E-09" ixz="1.086E-09"
        iyy="3.5113E-06" iyz="-1.1358E-09" izz="3.523E-06"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/Link1_1.STL"/>
      </geometry>
      <material name="dex1_body"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/Link1_1.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_dex1_finger_1_joint" type="prismatic">
    <origin xyz="0.04055 0.0593 0.0152" rpy="0 0 0"/>
    <parent link="right_dex1_base_link"/>
    <child link="right_dex1_finger_1_slider_link"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.02" upper="0.0245" effort="20" velocity="0.2"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="right_dex1_finger_1_link">
    <inertial>
      <origin xyz="0.0046767 0.026417 -0.014407" rpy="0 0 0"/>
      <mass value="0.028354"/>
      <inertia
        ixx="1.3423E-05" ixy="3.5258E-07" ixz="5.8181E-08"
        iyy="2.249E-06" iyz="6.3947E-07" izz="1.1892E-05"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/Link1_2.STL"/>
      </geometry>
      <material name="dex1_finger">
        <color rgba="0.89804 0.91765 0.92941 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/Link1_2.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_dex1_finger_1_tip_joint" type="fixed">
    <origin xyz="-0.013 0.013 0" rpy="0 0 0"/>
    <parent link="right_dex1_finger_1_slider_link"/>
    <child link="right_dex1_finger_1_link"/>
  </joint>

  <link name="right_dex1_finger_1_pad_link">
    <inertial>
      <origin xyz="0.0018267 0.017456 -0.0142" rpy="0 0 0"/>
      <mass value="0.004583"/>
      <inertia
        ixx="9.6165E-07" ixy="6.207E-09" ixz="0"
        iyy="2.5948E-07" iyz="0" izz="7.1226E-07"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/Link1_3.STL"/>
      </geometry>
      <material name="dex1_pad">
        <color rgba="0.18 0.18 0.18 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/Link1_3.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_dex1_finger_1_pad_joint" type="fixed">
    <origin xyz="-0.0025165 0.025043 -0.001" rpy="0 0 0"/>
    <parent link="right_dex1_finger_1_link"/>
    <child link="right_dex1_finger_1_pad_link"/>
  </joint>

  <link name="right_dex1_finger_2_slider_link">
    <inertial>
      <origin xyz="0.041607 0.0039411 0.00047344" rpy="0 0 0"/>
      <mass value="0.0084398"/>
      <inertia
        ixx="1.0466E-07" ixy="-4.1386E-09" ixz="1.086E-09"
        iyy="3.5113E-06" iyz="1.1358E-09" izz="3.523E-06"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/Link2_1.STL"/>
      </geometry>
      <material name="dex1_body"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/Link2_1.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_dex1_finger_2_joint" type="prismatic">
    <origin xyz="-0.04055 0.0593 -0.0152" rpy="0 0 0"/>
    <parent link="right_dex1_base_link"/>
    <child link="right_dex1_finger_2_slider_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.02" upper="0.0245" effort="20" velocity="0.2"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="right_dex1_finger_2_link">
    <inertial>
      <origin xyz="-0.0046767 0.026417 0.014407" rpy="0 0 0"/>
      <mass value="0.028354"/>
      <inertia
        ixx="1.3423E-05" ixy="-3.5258E-07" ixz="5.8181E-08"
        iyy="2.249E-06" iyz="-6.3947E-07" izz="1.1892E-05"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/Link2_2.STL"/>
      </geometry>
      <material name="dex1_finger"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/Link2_2.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_dex1_finger_2_tip_joint" type="fixed">
    <origin xyz="0.013 0.013 0" rpy="0 0 0"/>
    <parent link="right_dex1_finger_2_slider_link"/>
    <child link="right_dex1_finger_2_link"/>
  </joint>

  <!--
    Unitree ships Link2_3.STL but omits it from the released URDF.  The
    transform below mirrors the first dark contact pad onto finger 2.
  -->
  <link name="right_dex1_finger_2_pad_link">
    <inertial>
      <origin xyz="-0.0018267 0.017456 -0.0142" rpy="0 0 0"/>
      <mass value="0.004583"/>
      <inertia
        ixx="9.6165E-07" ixy="-6.207E-09" ixz="0"
        iyy="2.5948E-07" iyz="0" izz="7.1226E-07"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/Link2_3.STL"/>
      </geometry>
      <material name="dex1_pad"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://h1_2_description/meshes/dex1_1/Link2_3.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_dex1_finger_2_pad_joint" type="fixed">
    <origin xyz="0.0025165 0.025043 0.0294" rpy="0 0 0"/>
    <parent link="right_dex1_finger_2_link"/>
    <child link="right_dex1_finger_2_pad_link"/>
  </joint>

  <link name="right_dex1_tcp"/>
  <joint name="right_dex1_tcp_joint" type="fixed">
    <origin xyz="0 0.122 0" rpy="0 0 0"/>
    <parent link="right_dex1_base_link"/>
    <child link="right_dex1_tcp"/>
  </joint>
</robot>
